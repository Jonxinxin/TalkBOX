{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-msvc",
            "displayName": "Windows x64 (MSVC 2022, Visual Studio generator)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-msvc",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "C:/Qt/6.8.3/msvc2022_64"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "windows-msvc",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "configurePreset": "windows-msvc",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "windows-msvc",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "windows-msvc",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
